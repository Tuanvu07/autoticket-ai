# ============================================================
# ROOT .gitignore — autoticket-ai-workspace
# Aggressively blocks all generated / secret files across
# every sub-project in this mono-repo.
# ============================================================

# ── Node / JavaScript ────────────────────────────────────────
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
**/.cache/
**/.parcel-cache/
**/.swc/
**/.turbo/
**/.vercel/

# ── TypeScript build artifacts ───────────────────────────────
**/*.tsbuildinfo
**/next-env.d.ts

# ── Python ───────────────────────────────────────────────────
**/venv/
**/.venv/
**/env/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/instance/
**/db.sqlite3
**/migrations/versions/*.py

# ── Environment / Secrets ────────────────────────────────────
**/.env
**/.env.*
!**/.env.example

# ── OS junk ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors / IDEs ───────────────────────────────────────────
**/.idea/
**/.vscode/settings.json
**/.vscode/launch.json

# ── Logs ─────────────────────────────────────────────────────
**/*.log
**/*.log.*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ── Misc binaries / large generated assets ───────────────────
**/*.node
**/*.pnp.*
